+package com.example.e2e.pledge;
+
+import com.example.e2e.logging.Outcomes;
+
+/**
+ * Metric names of com.example.e2e.pledge, in one place: call sites call a member here and never name a metric.
+ * Generated by logast (metrics.catalog). Rename or document members freely; logast keeps them and adds new
+ * ones at the end.
+ */
+// logast:metrics-catalog
+public final class PledgeMetrics {
+    private PledgeMetrics() {
+    }
+
+    /** outcome="failed" on the timer already running (same thread). */
+    public static void tagFailed() {
+        Outcomes.tag("failed");
+    }
+
+    /** pledges{outcome="updated"} +1; rows is one sample of the distribution pledges.rows{outcome="updated"}. */
+    public static void pledgesUpdated(Number rows) {
+        Outcomes.record("pledges", "updated", "rows", rows);
+    }
+
+    /** pledge.usage{outcome="saved"} +1; pledge.usage.uses{outcome="saved"} grows by uses. */
+    public static void pledgeUsageSaved(Number uses) {
+        Outcomes.count("pledge.usage", "saved", "uses", uses);
+    }
+
+    /** pledge{outcome="sent"} +1. */
+    public static void pledgeSent() {
+        Outcomes.count("pledge", "sent");
+    }
+
+    /** pledge.resend{outcome="failed"} +1. */
+    public static void pledgeResendFailed() {
+        Outcomes.count("pledge.resend", "failed");
+    }
+
+    /** pledge{outcome="published"} +1. */
+    public static void pledgePublished() {
+        Outcomes.count("pledge", "published");
+    }
+
+    /** pledge.allotment{outcome="completed"} +1. */
+    public static void pledgeAllotmentCompleted() {
+        Outcomes.count("pledge.allotment", "completed");
+    }
+
+    /** Registers this catalog's counters at 0 when the application has started: a series exists before the first event. */
+    @org.springframework.stereotype.Component
+    static final class Registration implements org.springframework.beans.factory.SmartInitializingSingleton {
+        @Override
+        public void afterSingletonsInstantiated() {
+            Outcomes.registerPerRun("pledges", "updated", "rows");
+            Outcomes.registerTotal("pledge.usage", "saved", "uses");
+            Outcomes.register("pledge", "sent");
+            Outcomes.register("pledge.resend", "failed");
+            Outcomes.register("pledge", "published");
+            Outcomes.register("pledge.allotment", "completed");
+        }
+    }
+}
